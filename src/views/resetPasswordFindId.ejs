<!DOCTYPE html>
<html lang="ko">
<%- include('partials/head') %>
<body>
<%- include('partials/nav') %>
<div class="findpw-page">
  <h1 class="findid-title">비밀번호 찾기</h1>
  <p class="findid-subtitle">아이디 확인 후<br>비밀번호를 다시 설정하실 수 있습니다.</p>

  <div class="findpw-row">
    <label for="findPwUsername">아이디</label>
    <input type="text" id="findPwUsername" placeholder="아이디를 입력해주세요." />
    <button type="button" id="findPwCheckBtn">확인</button>
  </div>
  <p id="findPwError" class="error" style="display:none;"></p>

  <div class="findid-actions">
    <button type="button" class="btn-secondary" id="findPwCancelBtn">취소</button>
  </div>
</div>

<script>
  document.getElementById('findPwCancelBtn').addEventListener('click', function () {
    window.location.href = '/login';
  });

  document.getElementById('findPwCheckBtn').addEventListener('click', function () {
    var errorEl = document.getElementById('findPwError');
    errorEl.style.display = 'none';

    var username = document.getElementById('findPwUsername').value.trim();
    if (!username) {
      errorEl.textContent = '아이디를 입력해주세요.';
      errorEl.style.display = '';
      return;
    }
    fetch('/signup/check-username?username=' + encodeURIComponent(username))
      .then(function (res) { return res.json(); })
      .then(function (data) {
        if (data.available) {
          errorEl.textContent = '등록되지 않은 아이디입니다.';
          errorEl.style.display = '';
          return;
        }
        window.location.href = '/find-password/method?username=' + encodeURIComponent(username);
      });
  });
</script>
<%- include('partials/footer') %>
</body>
</html>
