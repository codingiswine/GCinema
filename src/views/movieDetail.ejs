<!DOCTYPE html>
<html lang="ko">
<%- include('partials/head') %>
<body>
<%- include('partials/nav') %>

<% if (movie.detailImageUrl) { %>
  <div class="detail-hero" style="background-image: url('<%= movie.detailImageUrl %>');"></div>
<% } %>

<div class="detail-info">
  <div class="detail-title-row">
    <h1><%= movie.title %></h1>
    <span class="age-badge age-<%= movie.ageRating %>"><%= movie.ageRating %></span>
  </div>
  <p class="detail-meta"><%= movie.runningTimeMin %>분 &nbsp;|&nbsp; <%= movie.genre %></p>

  <p class="movie-stats detail-stats">
    <img class="movie-stats-mark" src="/gc-mark.png" alt="" />
    <span>만족도 <%= movie.satisfactionPercent %>%·예매율 <%= movie.bookingRatePercent %>%·누적 <%= movie.cumulativeViewers %></span>
  </p>

  <hr class="detail-divider" />

  <p class="detail-synopsis"><%= movie.description %></p>

  <div class="date-strip">
    <% dateOptions.forEach(function(d) { %>
      <a class="date-item<%= d.isSat ? ' saturday' : '' %><%= d.isSun ? ' sunday' : '' %>" href="/movies/<%= movie.id %>?date=<%= d.key %>">
        <span class="date-weekday"><%= d.weekday %></span>
        <span class="date-day"><%= d.day %></span>
      </a>
    <% }) %>
  </div>

  <a class="btn-primary detail-book-btn" href="/movies/<%= movie.id %>">예매하기</a>
</div>

<%- include('partials/footer') %>
</body>
</html>
