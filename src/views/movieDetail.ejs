<!DOCTYPE html>
<html lang="ko">
<%- include('partials/head') %>
<body>
<%- include('partials/nav') %>

<div class="detail-topbar">
  <div class="detail-topbar-left">
    <button type="button" class="topbar-icon-btn" onclick="history.back()" aria-label="뒤로가기">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>
    <a class="topbar-icon-btn" href="/movies" aria-label="홈">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9a1 1 0 0 0 1 1H9a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h2.5a1 1 0 0 0 1-1v-9"></path></svg>
    </a>
  </div>
  <div class="detail-topbar-right">
    <button type="button" class="topbar-icon-btn" id="shareBtn" aria-label="공유">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15V4"></path><path d="M8 8l4-4 4 4"></path><path d="M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4"></path></svg>
    </button>
    <% if (userId) { %>
      <button type="button" class="topbar-icon-btn<%= liked ? ' liked' : '' %>" id="likeBtn" aria-label="좋아요" aria-pressed="<%= liked %>">
        <svg class="heart-outline" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-6.7-4.35-9.3-8.1C1 10.1 1.6 6.9 4.2 5.4c2.2-1.3 4.9-.7 6.3 1.3l1.5 2 1.5-2c1.4-2 4.1-2.6 6.3-1.3 2.6 1.5 3.2 4.7 1.5 7.5C18.7 16.65 12 21 12 21z"></path></svg>
        <svg class="heart-filled" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 21s-6.7-4.35-9.3-8.1C1 10.1 1.6 6.9 4.2 5.4c2.2-1.3 4.9-.7 6.3 1.3l1.5 2 1.5-2c1.4-2 4.1-2.6 6.3-1.3 2.6 1.5 3.2 4.7 1.5 7.5C18.7 16.65 12 21 12 21z"></path></svg>
      </button>
    <% } else { %>
      <a class="topbar-icon-btn" href="/login" aria-label="좋아요 (로그인 필요)">
        <svg class="heart-outline" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-6.7-4.35-9.3-8.1C1 10.1 1.6 6.9 4.2 5.4c2.2-1.3 4.9-.7 6.3 1.3l1.5 2 1.5-2c1.4-2 4.1-2.6 6.3-1.3 2.6 1.5 3.2 4.7 1.5 7.5C18.7 16.65 12 21 12 21z"></path></svg>
      </a>
    <% } %>
  </div>
</div>

<% if (movie.detailImageUrl) { %>
  <img class="detail-hero" src="<%= movie.detailImageUrl %>" alt="<%= movie.title %> 상세 이미지" />
<% } %>

<div class="detail-info">
  <div class="detail-title-row">
    <h1><%= movie.title %></h1>
    <span class="age-badge age-<%= movie.ageRating %>"><%= movie.ageRating %></span>
  </div>
  <% const rtH = Math.floor(movie.runningTimeMin / 60); const rtM = movie.runningTimeMin % 60; %>
  <p class="detail-meta"><%= rtH %>시간 <%= rtM %>분 &nbsp;|&nbsp; <%= movie.genre %></p>

  <p class="movie-stats detail-stats">
    <span class="movie-stats-primary">
      <img class="movie-stats-mark" src="/gc-mark.png" alt="" />
      만족도 <%= movie.satisfactionPercent %>% · 예매율 <%= movie.bookingRatePercent %>%
    </span>
    <span>누적 <%= movie.cumulativeViewers %></span>
  </p>

  <hr class="detail-divider" />

  <p class="detail-synopsis"><%= movie.description %></p>

  <div class="date-strip">
    <% dateOptions.forEach(function(d) { %>
      <a class="date-item<%= d.isSat ? ' saturday' : '' %><%= d.isSun ? ' sunday' : '' %>" href="/movies/<%= movie.id %>?date=<%= d.key %>">
        <span class="date-weekday"><%= d.weekday %></span>
        <span class="date-day"><%= d.day %></span>
      </a>
    <% }) %>
  </div>

  <a class="btn-primary detail-book-btn" href="/movies/<%= movie.id %>">예매하기</a>
</div>

<%- include('partials/footer') %>
<script>
  function showToast(message) {
    var toast = document.createElement('div');
    toast.className = 'toast';
    toast.textContent = message;
    document.body.appendChild(toast);
    requestAnimationFrame(function () { toast.classList.add('show'); });
    setTimeout(function () {
      toast.classList.remove('show');
      setTimeout(function () { toast.remove(); }, 300);
    }, 1800);
  }

  document.getElementById('shareBtn').addEventListener('click', async function () {
    const url = location.href;
    const title = document.title;
    if (navigator.share) {
      try { await navigator.share({ title, url }); } catch (e) { /* user cancelled */ }
      return;
    }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      try {
        await navigator.clipboard.writeText(url);
        showToast('링크가 복사되었습니다.');
        return;
      } catch (e) { /* fall through */ }
    }
    showToast(url);
  });

  var likeBtn = document.getElementById('likeBtn');
  if (likeBtn) {
    likeBtn.addEventListener('click', function () {
      likeBtn.disabled = true;
      fetch('/movies/<%= movie.id %>/like', { method: 'POST' })
        .then(function (res) { return res.ok ? res.json() : Promise.reject(res.status); })
        .then(function (body) {
          likeBtn.classList.toggle('liked', body.liked);
          likeBtn.setAttribute('aria-pressed', String(body.liked));
        })
        .catch(function () { window.location.href = '/login'; })
        .finally(function () { likeBtn.disabled = false; });
    });
  }
</script>
</body>
</html>
