<!DOCTYPE html>
<html lang="ko">
<%- include('partials/head') %>
<body>
<%- include('partials/nav') %>
<h1>영화 목록</h1>
<% movies.forEach(function(movie) { %>
  <div class="card">
    <a href="/movies/<%= movie.id %>"><%= movie.title %></a>
    <p><%= movie.genre %> · <%= movie.runningTimeMin %>분</p>
  </div>
<% }) %>
<% if (movies.length === 0) { %><p>등록된 영화가 없습니다.</p><% } %>
</body>
</html>
