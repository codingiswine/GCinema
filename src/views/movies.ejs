<!DOCTYPE html>
<html lang="ko">
<%- include('partials/head') %>
<body>
<%- include('partials/nav') %>
<h1>영화 목록</h1>
<div class="movie-list">
<% movies.forEach(function(movie, i) { %>
  <div class="movie-card">
    <a class="movie-poster-link" href="/movies/<%= movie.id %>/detail">
      <% if (movie.posterUrl) { %>
        <img class="movie-poster" src="<%= movie.posterUrl %>" alt="<%= movie.title %> 포스터" />
      <% } %>
      <span class="movie-rank"><%= i + 1 %></span>
      <span class="age-badge age-<%= movie.ageRating %> movie-age-overlay"><%= movie.ageRating %></span>
    </a>
    <div class="movie-info">
      <p class="movie-stats">
        <span class="movie-stats-primary">
          <svg class="movie-stats-heart" viewBox="0 0 24 24" width="12" height="12" fill="#e63950"><path d="M12 21s-6.7-4.35-9.3-8.1C1 10.1 1.6 6.9 4.2 5.4c2.2-1.3 4.9-.7 6.3 1.3l1.5 2 1.5-2c1.4-2 4.1-2.6 6.3-1.3 2.6 1.5 3.2 4.7 1.5 7.5C18.7 16.65 12 21 12 21z"></path></svg>
          만족도 <%= movie.satisfactionPercent %>% · 예매율 <%= movie.bookingRatePercent %>%
        </span>
        <span>누적 <%= movie.cumulativeViewers %></span>
      </p>
      <a class="movie-book-btn" href="/movies/<%= movie.id %>">예매하기</a>
    </div>
  </div>
<% }) %>
</div>
<% if (movies.length === 0) { %><p>등록된 영화가 없습니다.</p><% } %>

<%- include('partials/footer') %>
</body>
</html>
