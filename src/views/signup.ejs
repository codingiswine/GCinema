<!DOCTYPE html>
<html lang="ko">
<%- include('partials/head') %>
<body>
<%- include('partials/nav') %>
<div class="auth-box">
<h1>회원가입</h1>
<% if (error) { %><p class="error"><%= error %></p><% } %>
<form action="/signup" method="post" id="signupForm">
  <div style="display:flex; gap:6px;">
    <input type="text" name="username" id="username" placeholder="아이디" required style="flex:1" />
    <button type="button" id="checkUsernameBtn" style="white-space:nowrap;">중복확인</button>
  </div>
  <p id="usernameStatus" style="margin:0; font-size:0.85rem;"></p>

  <div style="display:flex; gap:6px; align-items:center;">
    <select id="phonePrefix" required style="flex:0 0 76px;">
      <option value="010">010</option>
      <option value="011">011</option>
      <option value="016">016</option>
      <option value="017">017</option>
      <option value="018">018</option>
      <option value="019">019</option>
    </select>
    <span>-</span>
    <input type="text" id="phoneMid" inputmode="numeric" maxlength="4" pattern="\d{3,4}"
      placeholder="1234" required style="flex:1; min-width:0;" />
    <span>-</span>
    <input type="text" id="phoneLast" inputmode="numeric" maxlength="4" pattern="\d{4}"
      placeholder="5678" required style="flex:1; min-width:0;" />
  </div>

  <div style="display:flex; gap:6px; align-items:center;">
    <input type="text" id="emailLocal" placeholder="이메일" required style="flex:1; min-width:0;" />
    <span>@</span>
    <select id="emailDomainSelect" style="flex:1; min-width:0;">
      <option value="custom">직접입력</option>
      <option value="naver.com">naver.com</option>
      <option value="gmail.com">gmail.com</option>
      <option value="daum.net">daum.net</option>
      <option value="hanmail.net">hanmail.net</option>
      <option value="nate.com">nate.com</option>
    </select>
  </div>
  <input type="text" id="emailDomainCustom" placeholder="도메인 입력 (예: gmail.com)" required />

  <input type="password" name="password" placeholder="비밀번호" required minlength="4" />
  <input type="password" name="passwordConfirm" placeholder="비밀번호 확인" required minlength="4" />
  <input type="hidden" name="phone" id="phoneHidden" />
  <input type="hidden" name="email" id="emailHidden" />
  <button type="submit" id="submitBtn" disabled>가입하기</button>
</form>
<p>이미 계정이 있으신가요? <a href="/login">로그인</a></p>
</div>
<script>
  var usernameInput = document.getElementById('username');
  var checkBtn = document.getElementById('checkUsernameBtn');
  var statusEl = document.getElementById('usernameStatus');
  var submitBtn = document.getElementById('submitBtn');

  usernameInput.addEventListener('input', function () {
    submitBtn.disabled = true;
    statusEl.textContent = '';
  });

  checkBtn.addEventListener('click', function () {
    var username = usernameInput.value.trim();
    if (!username) {
      statusEl.style.color = '#c0392b';
      statusEl.textContent = '아이디를 입력해주세요.';
      return;
    }
    fetch('/signup/check-username?username=' + encodeURIComponent(username))
      .then(function (res) { return res.json(); })
      .then(function (data) {
        if (data.available) {
          statusEl.style.color = '#2e7d32';
          statusEl.textContent = '사용 가능한 아이디입니다.';
          submitBtn.disabled = false;
        } else {
          statusEl.style.color = '#c0392b';
          statusEl.textContent = '이미 사용 중인 아이디입니다.';
          submitBtn.disabled = true;
        }
      });
  });

  var emailDomainSelect = document.getElementById('emailDomainSelect');
  var emailDomainCustom = document.getElementById('emailDomainCustom');
  var emailLocal = document.getElementById('emailLocal');

  function updateEmailMode() {
    var isCustom = emailDomainSelect.value === 'custom';
    emailDomainCustom.style.display = isCustom ? '' : 'none';
    emailDomainCustom.required = isCustom;
  }
  emailDomainSelect.addEventListener('change', updateEmailMode);
  updateEmailMode();

  document.getElementById('signupForm').addEventListener('submit', function () {
    var prefix = document.getElementById('phonePrefix').value;
    var mid = document.getElementById('phoneMid').value.trim();
    var last = document.getElementById('phoneLast').value.trim();
    document.getElementById('phoneHidden').value = prefix + '-' + mid + '-' + last;

    var local = emailLocal.value.trim();
    var isCustom = emailDomainSelect.value === 'custom';
    var domain = isCustom ? emailDomainCustom.value.trim() : emailDomainSelect.value;
    document.getElementById('emailHidden').value = local + '@' + domain;
  });
</script>
<%- include('partials/footer') %>
</body>
</html>
