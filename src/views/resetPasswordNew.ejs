<!DOCTYPE html>
<html lang="ko">
<%- include('partials/head') %>
<body>
<%- include('partials/nav') %>
<div class="auth-box">
<h1>비밀번호 재설정</h1>
<% if (error) { %><p class="error"><%= error %></p><% } %>
<form action="/find-password/reset" method="post" id="resetPasswordForm">
  <input type="password" name="password" id="newPassword" placeholder="새 비밀번호 (영문+숫자+특수문자 8자 이상)" required />
  <input type="password" name="passwordConfirm" id="newPasswordConfirm" placeholder="새 비밀번호 확인" required />
  <p id="newPasswordStatus" class="error" style="display:none; margin:0;"></p>
  <input type="hidden" name="token" value="<%= token %>" />
  <button type="submit">비밀번호 변경</button>
</form>
</div>
<script>
  var PASSWORD_PATTERN = /^(?=.*[A-Za-z])(?=.*\d)(?=.*[^A-Za-z0-9\s]).{8,}$/;
  var passwordInput = document.getElementById('newPassword');
  var passwordConfirmInput = document.getElementById('newPasswordConfirm');
  var statusEl = document.getElementById('newPasswordStatus');

  document.getElementById('resetPasswordForm').addEventListener('submit', function (e) {
    if (!PASSWORD_PATTERN.test(passwordInput.value)) {
      e.preventDefault();
      statusEl.textContent = '비밀번호는 영문, 숫자, 특수문자를 포함해 8자 이상이어야 합니다.';
      statusEl.style.display = '';
      passwordInput.focus();
      return;
    }
    if (passwordInput.value !== passwordConfirmInput.value) {
      e.preventDefault();
      statusEl.textContent = '비밀번호가 일치하지 않습니다.';
      statusEl.style.display = '';
      passwordConfirmInput.focus();
      return;
    }
    statusEl.style.display = 'none';
  });
</script>
<%- include('partials/footer') %>
</body>
</html>
