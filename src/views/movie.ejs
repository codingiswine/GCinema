<!DOCTYPE html>
<html lang="ko">
<%- include('partials/head') %>
<body>
<%- include('partials/nav') %>

<div class="schedule-layout">
  <aside class="movie-sidebar">
    <% movies.forEach(function(m) { %>
      <a class="movie-sidebar-item<%= m.id === movie.id ? ' active' : '' %>"
         href="/movies/<%= m.id %>?date=<%= selectedKey %>">
        <span class="age-badge age-<%= m.ageRating %>"><%= m.ageRating %></span>
        <span><%= m.title %></span>
      </a>
    <% }) %>
  </aside>

  <section class="schedule-panel">
    <div class="date-strip">
      <% dateOptions.forEach(function(d) { %>
        <a class="date-item<%= d.key === selectedKey ? ' selected' : '' %><%= d.isSat ? ' saturday' : '' %><%= d.isSun ? ' sunday' : '' %>"
           href="/movies/<%= movie.id %>?date=<%= d.key %>">
          <span class="date-day"><%= d.day %></span>
          <span class="date-weekday"><%= d.weekday %></span>
        </a>
      <% }) %>
    </div>

    <div class="schedule-theater">GCinema</div>
    <div class="schedule-movie-header">
      <span class="age-badge age-<%= movie.ageRating %>"><%= movie.ageRating %></span>
      <strong><%= movie.title %></strong>
      <% const rtH = Math.floor(movie.runningTimeMin / 60); const rtM = movie.runningTimeMin % 60; %>
      <span class="schedule-movie-meta"><%= movie.genre %> · <%= rtH %>시간 <%= rtM %>분</span>
    </div>

    <% if (showtimes.length === 0) { %>
      <% if (selectedKey === dateOptions[0].key) { %>
        <p>오늘 남은 상영 회차가 없습니다. 다른 날짜를 선택해주세요.</p>
      <% } else { %>
        <p>선택한 날짜에는 상영 정보가 없습니다.</p>
      <% } %>
    <% } else { %>
      <p class="schedule-hall-label"><%= showtimes[0].theaterName %> · 리클라이너 · 총 <%= showtimes[0].totalSeats %>석</p>
      <div class="showtime-list">
        <% showtimes.forEach(function(st) { %>
          <% const stHour = new Date(st.startAt).getHours(); %>
          <a class="showtime-btn" href="/showtimes/<%= st.id %>" data-start="<%= st.startAt.toISOString() %>">
            <span class="showtime-time"><%= new Date(st.startAt).toLocaleTimeString('ko-KR', { hour: '2-digit', minute: '2-digit', hour12: false }) %></span>
            <span class="showtime-seats">
              <%= st.theaterName %> ·
              <%= st.totalSeats - st._count.bookings %>/<%= st.totalSeats %>
              <% if (stHour < 10) { %><span class="showtime-band-icon" title="조조">☀️</span><% } %>
              <% if (stHour >= 23) { %><span class="showtime-band-icon" title="심야">🌙</span><% } %>
            </span>
          </a>
        <% }) %>
      </div>
    <% } %>
  </section>
</div>

<!-- 로그인 필요 안내 팝업 -->
<div id="loginRequiredModal" class="modal-overlay" style="display:none;">
  <div class="modal-box">
    <div class="modal-header">
      <span>알림</span>
      <button type="button" class="modal-close" data-modal="loginRequiredModal">&times;</button>
    </div>
    <div class="modal-body">
      <p>로그인이 필요한 서비스입니다.</p>
    </div>
    <button type="button" class="modal-confirm" id="loginRequiredConfirmBtn">확인</button>
  </div>
</div>

<!-- 상영시간이 20분 미만으로 남은 회차 예매 확인 팝업 -->
<div id="lastMinuteModal" class="modal-overlay" style="display:none;">
  <div class="modal-box">
    <div class="modal-header">
      <span>알림</span>
      <button type="button" class="modal-close" data-modal="lastMinuteModal">&times;</button>
    </div>
    <div class="modal-body">
      <p>영화상영시간이 20분 미만으로 남아있어 예매 취소는 현장에서만 가능합니다. 예매하시겠습니까?</p>
    </div>
    <div class="modal-actions">
      <button type="button" class="btn-secondary" data-modal="lastMinuteModal">취소</button>
      <button type="button" class="modal-confirm" id="lastMinuteConfirmBtn">확인</button>
    </div>
  </div>
</div>

<script>
  var LOGGED_IN = <%- JSON.stringify(!!userId) %>;
  var LAST_MINUTE_CUTOFF_MS = 20 * 60 * 1000;
  var pendingShowtimeHref = null;

  // X 버튼(.modal-close)뿐 아니라 취소 버튼처럼 data-modal만 붙은
  // 버튼도 같은 방식으로 닫히게 한다.
  document.querySelectorAll('[data-modal]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.getElementById(btn.dataset.modal).style.display = 'none';
    });
  });

  // 로그인 상태면 좌석 페이지로 바로 이동시키고, 아니면 로그인이 필요하다는
  // 팝업을 먼저 보여준다(확인 시 서버의 requireLogin이 next로 되돌려준다).
  function proceedToShowtime(href) {
    if (!LOGGED_IN) {
      pendingShowtimeHref = href;
      document.getElementById('loginRequiredModal').style.display = 'flex';
      return;
    }
    window.location.href = href;
  }

  document.getElementById('loginRequiredConfirmBtn').addEventListener('click', function () {
    window.location.href = pendingShowtimeHref || '/login';
  });

  document.getElementById('lastMinuteConfirmBtn').addEventListener('click', function () {
    document.getElementById('lastMinuteModal').style.display = 'none';
    proceedToShowtime(pendingShowtimeHref);
  });

  document.querySelectorAll('.showtime-btn').forEach(function (el) {
    el.addEventListener('click', function (e) {
      e.preventDefault();
      var href = el.getAttribute('href');
      var msLeft = new Date(el.dataset.start).getTime() - Date.now();
      if (msLeft < LAST_MINUTE_CUTOFF_MS) {
        pendingShowtimeHref = href;
        document.getElementById('lastMinuteModal').style.display = 'flex';
        return;
      }
      proceedToShowtime(href);
    });
  });
</script>

<%- include('partials/footer') %>
</body>
</html>
