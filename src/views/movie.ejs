<!DOCTYPE html>
<html lang="ko">
<%- include('partials/head') %>
<body>
<%- include('partials/nav') %>

<div class="schedule-layout">
  <aside class="movie-sidebar">
    <% movies.forEach(function(m) { %>
      <a class="movie-sidebar-item<%= m.id === movie.id ? ' active' : '' %>"
         href="/movies/<%= m.id %>?date=<%= selectedKey %>">
        <span class="age-badge age-<%= m.ageRating %>"><%= m.ageRating %></span>
        <span><%= m.title %></span>
      </a>
    <% }) %>
  </aside>

  <section class="schedule-panel">
    <div class="date-strip">
      <% dateOptions.forEach(function(d) { %>
        <a class="date-item<%= d.key === selectedKey ? ' selected' : '' %><%= d.isSat ? ' saturday' : '' %><%= d.isSun ? ' sunday' : '' %>"
           href="/movies/<%= movie.id %>?date=<%= d.key %>">
          <span class="date-day"><%= d.day %></span>
          <span class="date-weekday"><%= d.weekday %></span>
        </a>
      <% }) %>
    </div>

    <div class="schedule-theater">GCinema</div>
    <div class="schedule-movie-header">
      <span class="age-badge age-<%= movie.ageRating %>"><%= movie.ageRating %></span>
      <strong><%= movie.title %></strong>
      <% const rtH = Math.floor(movie.runningTimeMin / 60); const rtM = movie.runningTimeMin % 60; %>
      <span class="schedule-movie-meta"><%= movie.genre %> · <%= rtH %>시간 <%= rtM %>분</span>
    </div>

    <% if (showtimes.length === 0) { %>
      <% if (selectedKey === dateOptions[0].key) { %>
        <p>오늘 남은 상영 회차가 없습니다. 다른 날짜를 선택해주세요.</p>
      <% } else { %>
        <p>선택한 날짜에는 상영 정보가 없습니다.</p>
      <% } %>
    <% } else { %>
      <p class="schedule-hall-label"><%= showtimes[0].theaterName %> · 리클라이너+일반 · 총 <%= showtimes[0].totalSeats %>석</p>
      <div class="showtime-list">
        <% showtimes.forEach(function(st) { %>
          <a class="showtime-btn" href="/showtimes/<%= st.id %>">
            <span class="showtime-time"><%= new Date(st.startAt).toLocaleTimeString('ko-KR', { hour: '2-digit', minute: '2-digit', hour12: false }) %></span>
            <span class="showtime-seats"><%= st.totalSeats - st._count.bookings %>/<%= st.totalSeats %> · <%= st.theaterName %></span>
          </a>
        <% }) %>
      </div>
    <% } %>
  </section>
</div>

<!-- 로그인 필요 안내 팝업 -->
<div id="loginRequiredModal" class="modal-overlay" style="display:none;">
  <div class="modal-box">
    <div class="modal-header">
      <span>알림</span>
      <button type="button" class="modal-close" data-modal="loginRequiredModal">&times;</button>
    </div>
    <div class="modal-body">
      <p>로그인이 필요한 서비스입니다.</p>
    </div>
    <button type="button" class="modal-confirm" id="loginRequiredConfirmBtn">확인</button>
  </div>
</div>

<script>
  var LOGGED_IN = <%- JSON.stringify(!!userId) %>;
  var pendingShowtimeHref = null;

  document.querySelectorAll('.modal-close').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.getElementById(btn.dataset.modal).style.display = 'none';
    });
  });
  document.getElementById('loginRequiredConfirmBtn').addEventListener('click', function () {
    // 클릭했던 회차의 좌석 페이지로 이동시키면, 그 경로에 걸린 서버의
    // requireLogin이 알아서 /login?next=<원래 경로>로 보내주므로
    // 로그인 후 처음 눌렀던 좌석 선택 화면으로 바로 돌아온다.
    window.location.href = pendingShowtimeHref || '/login';
  });

  if (!LOGGED_IN) {
    document.querySelectorAll('.showtime-btn').forEach(function (el) {
      el.addEventListener('click', function (e) {
        e.preventDefault();
        pendingShowtimeHref = el.getAttribute('href');
        document.getElementById('loginRequiredModal').style.display = 'flex';
      });
    });
  }
</script>

<%- include('partials/footer') %>
</body>
</html>
