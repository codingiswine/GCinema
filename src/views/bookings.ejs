<!DOCTYPE html>
<html lang="ko">
<%- include('partials/head') %>
<body>
<%- include('partials/nav') %>
<h1>마이페이지</h1>

<div class="mypage-tabs">
  <a class="mypage-tab<%= tab === 'watched' ? ' active' : '' %>" href="/bookings?tab=watched">내가 본 영화</a>
  <a class="mypage-tab<%= tab === 'payments' ? ' active' : '' %>" href="/bookings?tab=payments">결제내역</a>
  <a class="mypage-tab<%= tab === 'diary' ? ' active' : '' %>" href="/bookings?tab=diary">나의 영화일기</a>
  <a class="mypage-tab<%= tab === 'inquiry' ? ' active' : '' %>" href="/bookings?tab=inquiry">1:1 문의</a>
  <a class="mypage-tab<%= tab === 'profile' ? ' active' : '' %>" href="/bookings?tab=profile">나의 정보관리</a>
</div>

<% if (tab === 'payments') { %>
  <div class="mypage-subtabs">
    <a class="mypage-subtab<%= sub !== 'cancelled' ? ' active' : '' %>" href="/bookings?tab=payments&sub=reserved">예매내역</a>
    <a class="mypage-subtab<%= sub === 'cancelled' ? ' active' : '' %>" href="/bookings?tab=payments&sub=cancelled">취소내역</a>
  </div>
<% } %>

<% if (tab === 'diary' || tab === 'inquiry' || tab === 'profile') { %>
  <p class="mypage-placeholder">준비 중입니다.</p>
<% } else { %>
  <% var showCancelBtn = tab === 'payments' && sub !== 'cancelled'; %>
  <% bookings.forEach(function(b) { %>
    <div class="card" id="booking-<%= b.id %>">
      <div class="booking-card-head">
        <strong><%= b.showtime.movie.title %></strong>
        <% if (showCancelBtn) { %>
          <button type="button" class="btn-secondary booking-cancel-btn" data-booking-id="<%= b.id %>">예매 취소</button>
        <% } else if (tab === 'payments' && sub === 'cancelled') { %>
          <span class="booking-cancelled-label">취소완료 · <%= new Date(b.cancelledAt).toLocaleDateString('ko-KR') %></span>
        <% } else if (tab === 'watched') { %>
          <span class="booking-watched-label">관람완료</span>
        <% } %>
      </div>
      <p><%= b.showtime.theaterName %> · <%= new Date(b.showtime.startAt).toLocaleString('ko-KR') %> · 좌석 <%= b.seatLabel %> · <%= categoryLabels[b.category] %> <%= b.price.toLocaleString() %>원</p>
    </div>
  <% }) %>
  <% if (bookings.length === 0) { %>
    <p>
      <% if (tab === 'watched') { %>본 영화가 없습니다.
      <% } else if (sub === 'cancelled') { %>취소 내역이 없습니다.
      <% } else { %>예매 내역이 없습니다.
      <% } %>
    </p>
  <% } %>
<% } %>

<!-- 예매 취소 확인 팝업 -->
<div id="cancelModal" class="modal-overlay" style="display:none;">
  <div class="modal-box">
    <div class="modal-header">
      <span>알림</span>
      <button type="button" class="modal-close" data-modal="cancelModal">&times;</button>
    </div>
    <div class="modal-body">
      <p>예매 취소 하시겠습니까?</p>
    </div>
    <button type="button" class="modal-confirm" id="cancelConfirmBtn">확인</button>
  </div>
</div>

<script>
  var cancelTargetId = null;

  document.querySelectorAll('.modal-close').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.getElementById(btn.dataset.modal).style.display = 'none';
    });
  });

  document.querySelectorAll('.booking-cancel-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      cancelTargetId = btn.dataset.bookingId;
      document.getElementById('cancelModal').style.display = 'flex';
    });
  });

  var cancelConfirmBtn = document.getElementById('cancelConfirmBtn');
  if (cancelConfirmBtn) {
    cancelConfirmBtn.addEventListener('click', function () {
      if (!cancelTargetId) return;
      fetch('/bookings/' + cancelTargetId + '/cancel', { method: 'POST' })
        .then(function () { window.location.reload(); });
    });
  }
</script>

<%- include('partials/footer') %>
</body>
</html>
