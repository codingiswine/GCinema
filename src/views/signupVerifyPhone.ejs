<!DOCTYPE html>
<html lang="ko">
<%- include('partials/head') %>
<body>
<%- include('partials/nav') %>
<div class="verify-phone-box">
  <h1>회원가입을 위해<br>휴대폰 본인 인증해주세요.</h1>

  <div class="verify-agree">
    <label class="verify-agree-row"><input type="checkbox" id="agreeAll" /> 휴대폰 본인확인 전체동의</label>
    <label class="verify-agree-row"><input type="checkbox" class="agreeRequired" /> 개인정보 이용 동의(필수)</label>
    <label class="verify-agree-row"><input type="checkbox" class="agreeRequired" /> 서비스 이용약관 동의(필수)</label>
    <p id="verifyAgreeError" class="error" style="display:none;"></p>
  </div>

  <div class="verify-field">
    <label for="verifyName">이름</label>
    <input type="text" id="verifyName" placeholder="이름을 입력해주세요." />
    <p id="verifyNameError" class="error" style="display:none;"></p>
  </div>
  <div class="verify-field">
    <label for="verifyBirth">생년월일/성별</label>
    <div class="verify-field-row">
      <input type="text" id="verifyBirth" inputmode="numeric" maxlength="6" placeholder="생년월일 6자리" />
      <span>-</span>
      <input type="text" id="verifyGenderDigit" inputmode="numeric" maxlength="1" class="verify-gender-digit" />
      <span class="verify-masked-digits">●●●●●●</span>
    </div>
    <p id="verifyBirthError" class="error" style="display:none;"></p>
  </div>
  <div class="verify-field">
    <label for="verifyPhoneMid">휴대폰 번호</label>
    <div class="verify-field-row verify-phone-row">
      <select id="verifyCarrier">
        <option>SKT</option>
        <option>KT</option>
        <option>LG U+</option>
        <option>SKT 알뜰폰</option>
        <option>KT 알뜰폰</option>
        <option>LGU+ 알뜰폰</option>
      </select>
      <select id="verifyPhonePrefix">
        <option value="010">010</option>
        <option value="011">011</option>
        <option value="016">016</option>
        <option value="017">017</option>
        <option value="018">018</option>
        <option value="019">019</option>
      </select>
      <input type="text" id="verifyPhoneMid" inputmode="numeric" maxlength="4" placeholder="1234" />
      <span>-</span>
      <input type="text" id="verifyPhoneLast" inputmode="numeric" maxlength="4" placeholder="5678" />
    </div>
    <p id="verifyPhoneError" class="error" style="display:none;"></p>
  </div>

  <p class="verify-legal-note">휴대폰 본인확인 시 타인 명의를 도용할 경우, “정보통신망법 제 49조”에 의거하여 5년 이하의 징역 또는 5천만원 이하의 벌금에 처할 수 있습니다.</p>

  <div class="verify-actions">
    <button type="button" class="btn-secondary" id="verifyCancelBtn">취소</button>
    <button type="button" id="verifyRequestBtn">인증 요청</button>
  </div>
</div>

<!-- 본인인증 완료 안내 팝업 -->
<div id="verifyDoneModal" class="modal-overlay" style="display:none;">
  <div class="modal-box">
    <div class="modal-header">
      <span>알림</span>
    </div>
    <div class="modal-body">
      <p>본인인증이 완료되었습니다.<br>회원가입 페이지로 넘어갑니다.</p>
    </div>
    <button type="button" class="modal-confirm" id="verifyDoneConfirmBtn">확인</button>
  </div>
</div>

<script>
  document.getElementById('verifyCancelBtn').addEventListener('click', function () {
    window.location.href = '/signup/verify';
  });

  var agreeAll = document.getElementById('agreeAll');
  var agreeRequired = document.querySelectorAll('.agreeRequired');
  agreeAll.addEventListener('change', function () {
    agreeRequired.forEach(function (cb) { cb.checked = agreeAll.checked; });
  });

  // 에러는 원인이 된 줄 옆에 바로 보여준다(화면 맨 아래 공용 문구 대신).
  var fieldErrorIds = ['verifyAgreeError', 'verifyNameError', 'verifyBirthError', 'verifyPhoneError'];
  function clearFieldErrors() {
    fieldErrorIds.forEach(function (id) {
      var el = document.getElementById(id);
      el.textContent = '';
      el.style.display = 'none';
    });
  }
  function showFieldError(id, msg) {
    var el = document.getElementById(id);
    el.textContent = msg;
    el.style.display = '';
  }

  // 자음/모음만 있는 입력(예: "ㅁㄴㄴ")과 영문 모두 걸러지고, 완성된 한글
  // 음절(가-힣)만 통과한다.
  var NAME_PATTERN = /^[가-힣]+$/;

  // 생년월일/성별/휴대폰번호는 숫자만 받아야 하므로, 입력 즉시 숫자가 아닌
  // 문자를 지워 애초에 문자가 들어갈 수 없게 한다(붙여넣기 포함).
  ['verifyBirth', 'verifyGenderDigit', 'verifyPhoneMid', 'verifyPhoneLast'].forEach(function (id) {
    var el = document.getElementById(id);
    el.addEventListener('input', function () {
      el.value = el.value.replace(/\D/g, '');
    });
  });

  document.getElementById('verifyRequestBtn').addEventListener('click', function () {
    clearFieldErrors();

    var allAgreed = Array.prototype.every.call(agreeRequired, function (cb) { return cb.checked; });
    if (!allAgreed) {
      showFieldError('verifyAgreeError', '필수 약관에 모두 동의해주세요.');
      return;
    }
    var name = document.getElementById('verifyName').value.trim();
    if (!name) {
      showFieldError('verifyNameError', '이름을 입력해주세요.');
      return;
    }
    if (!NAME_PATTERN.test(name)) {
      showFieldError('verifyNameError', '이름은 한글로 입력해주세요.');
      return;
    }
    var birth = document.getElementById('verifyBirth').value.trim();
    var genderDigit = document.getElementById('verifyGenderDigit').value.trim();
    if (!birth || !genderDigit) {
      showFieldError('verifyBirthError', '생년월일/성별을 입력해주세요.');
      return;
    }
    if (!/^\d{6}$/.test(birth)) {
      showFieldError('verifyBirthError', '생년월일 6자리를 숫자로 입력해주세요.');
      return;
    }
    // 성별 코드는 내국인 기준 1~4만 유효하다(1·2: 1900년대생, 3·4: 2000년대생).
    if (!/^[1234]$/.test(genderDigit)) {
      showFieldError('verifyBirthError', '제대로된 생년월일/성별을 입력해주세요.');
      return;
    }
    var mid = document.getElementById('verifyPhoneMid').value.trim();
    var last = document.getElementById('verifyPhoneLast').value.trim();
    if (!mid || !last) {
      showFieldError('verifyPhoneError', '휴대폰 번호를 입력해주세요.');
      return;
    }
    if (!/^\d{3,4}$/.test(mid) || !/^\d{4}$/.test(last)) {
      showFieldError('verifyPhoneError', '휴대폰 번호를 숫자로 정확히 입력해주세요.');
      return;
    }
    document.getElementById('verifyDoneModal').style.display = 'flex';
  });

  document.getElementById('verifyDoneConfirmBtn').addEventListener('click', function () {
    window.location.href = '/signup';
  });
</script>
<%- include('partials/footer') %>
</body>
</html>
