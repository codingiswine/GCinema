<!DOCTYPE html>
<html lang="ko">
<%- include('partials/head') %>
<body>
<%- include('partials/nav') %>
<h1><%= showtime.movie.title %></h1>
<p><%= showtime.theaterName %> · <%= new Date(showtime.startAt).toLocaleString('ko-KR') %></p>
<% if (error) { %><p class="error"><%= error %></p><% } %>

<div class="screen-wrap">
  <div class="screen-bar"></div>
  <div class="screen-label">SCREEN</div>
</div>

<div class="seat-grid">
<% for (let r = 0; r < showtime.rows; r++) { %>
  <div class="seat-row">
  <% seats.slice(r * showtime.cols, r * showtime.cols + showtime.cols).forEach(function(seat) { %>
    <% if (seat.booked) { %>
      <div class="seat booked"><%= seat.label %></div>
    <% } else { %>
      <form action="/showtimes/<%= showtime.id %>/book" method="post" style="margin:0">
        <input type="hidden" name="seatLabel" value="<%= seat.label %>" />
        <button type="submit" class="seat"><%= seat.label %></button>
      </form>
    <% } %>
  <% }) %>
  </div>
<% } %>
</div>
<div class="seat-legend">
  <span><i class="seat-swatch available"></i> 선택 가능</span>
  <span><i class="seat-swatch booked"></i> 예매 완료</span>
</div>
<p class="seat-hint">좌석을 클릭하면 바로 예매됩니다.</p>
<%- include('partials/footer') %>
</body>
</html>
