<!DOCTYPE html>
<html lang="ko">
<%- include('partials/head') %>
<body>
<%- include('partials/nav') %>

<div class="seat-page-layout">
  <div class="seat-page-main">
    <p id="bookError" class="error" style="display:none;"></p>

    <div class="ticket-panel">
      <div class="ticket-panel-header">
        <h2>관람인원선택</h2>
        <button type="button" id="resetBtn" class="btn-secondary">초기화</button>
      </div>
      <div class="ticket-types">
        <div class="ticket-type">
          <span class="ticket-type-label">성인<br><small><%= prices.ADULT.toLocaleString() %>원</small></span>
          <div class="counter">
            <button type="button" class="counter-btn" data-category="ADULT" data-delta="-1">-</button>
            <span class="counter-value" id="count-ADULT">0</span>
            <button type="button" class="counter-btn" data-category="ADULT" data-delta="1">+</button>
          </div>
        </div>
        <div class="ticket-type">
          <span class="ticket-type-label">청소년<br><small><%= prices.TEEN.toLocaleString() %>원</small></span>
          <div class="counter">
            <button type="button" class="counter-btn" data-category="TEEN" data-delta="-1">-</button>
            <span class="counter-value" id="count-TEEN">0</span>
            <button type="button" class="counter-btn" data-category="TEEN" data-delta="1">+</button>
          </div>
        </div>
        <div class="ticket-type">
          <span class="ticket-type-label">경로<br><small><%= prices.SENIOR.toLocaleString() %>원</small></span>
          <div class="counter">
            <button type="button" class="counter-btn" data-category="SENIOR" data-delta="-1">-</button>
            <span class="counter-value" id="count-SENIOR">0</span>
            <button type="button" class="counter-btn" id="seniorPlusBtn" data-category="SENIOR" data-delta="1">+</button>
          </div>
        </div>
        <div class="ticket-type">
          <span class="ticket-type-label">우대<br><small><%= prices.DISABLED.toLocaleString() %>원</small></span>
          <div class="counter">
            <button type="button" class="counter-btn" data-category="DISABLED" data-delta="-1">-</button>
            <span class="counter-value" id="count-DISABLED">0</span>
            <button type="button" class="counter-btn" id="disabledPlusBtn" data-category="DISABLED" data-delta="1">+</button>
          </div>
        </div>
      </div>
    </div>

    <div class="screen-wrap">
      <div class="screen-bar"></div>
      <div class="screen-label">SCREEN</div>
    </div>

    <div class="seat-grid">
    <% for (let r = 0; r < rows; r++) { %>
      <div class="seat-row">
      <% seats.slice(r * showtime.cols, r * showtime.cols + showtime.cols).forEach(function(seat, c) { %>
        <% if (seat.booked) { %>
          <div class="seat booked"><%= seat.label %></div>
        <% } else { %>
          <button type="button" class="seat" data-row="<%= r %>" data-col="<%= c %>" data-label="<%= seat.label %>"><%= seat.label %></button>
        <% } %>
      <% }) %>
      </div>
    <% } %>
    </div>
  </div>

  <aside class="seat-sidebar">
    <div class="seat-sidebar-movie">
      <div class="seat-sidebar-movie-text">
        <span class="age-badge age-<%= showtime.movie.ageRating %>"><%= showtime.movie.ageRating %></span>
        <h2><%= showtime.movie.title %></h2>
        <p class="seat-sidebar-theater"><%= showtime.theaterName %></p>
        <p class="seat-sidebar-datetime"><%= new Date(showtime.startAt).toLocaleString('ko-KR') %></p>
      </div>
      <% if (showtime.movie.posterUrl) { %>
        <img class="seat-sidebar-poster" src="<%= showtime.movie.posterUrl %>" alt="<%= showtime.movie.title %> 포스터" />
      <% } %>
    </div>

    <div class="seat-sidebar-legend">
      <span><i class="seat-swatch available"></i> 선택 가능</span>
      <span><i class="seat-swatch selected"></i> 선택</span>
      <span><i class="seat-swatch booked"></i> 예매 완료</span>
    </div>

    <div class="seat-sidebar-block">
      <p class="seat-sidebar-label">선택좌석</p>
      <div id="selectedSeatChips" class="seat-sidebar-chips">
        <span class="seat-sidebar-empty">좌석을 선택해주세요</span>
      </div>
    </div>

    <div class="seat-sidebar-block">
      <p id="selectedCountText" class="seat-sidebar-label">선택 좌석 0 / 0</p>
      <p class="seat-sidebar-total">
        <span>최종결제금액</span>
        <strong id="totalPriceText">0원</strong>
      </p>
    </div>

    <button type="button" id="confirmBookBtn" class="btn-checkout seat-sidebar-book-btn" disabled>결제하기</button>
  </aside>
</div>

<!-- 경로 안내 팝업 -->
<div id="seniorModal" class="modal-overlay" style="display:none;">
  <div class="modal-box">
    <div class="modal-header">
      <span>알림</span>
      <button type="button" class="modal-close" data-modal="seniorModal">&times;</button>
    </div>
    <div class="modal-body">
      <p>◆ 경로 : 만 65세 이상(신분증)</p>
      <p>경로요금은 만65세 이상 고객에게만 적용되며, 상영관 입장 시 본인신분증을 제시해 주시기 바랍니다(*미지참시 입장 제한)</p>
      <p>*경로선택 시 추가 할인이 제한될 수 있습니다</p>
    </div>
    <button type="button" class="modal-confirm" data-confirm="SENIOR">확인</button>
  </div>
</div>

<!-- 우대 안내 팝업 -->
<div id="disabledModal" class="modal-overlay" style="display:none;">
  <div class="modal-box">
    <div class="modal-header">
      <span>알림</span>
      <button type="button" class="modal-close" data-modal="disabledModal">&times;</button>
    </div>
    <div class="modal-body">
      <p>※만 65세이상 고객님께서는 [경로]발권 부탁드립니다(*지점별 상이)</p>
      <p>◆ 우대요금은 장애인 고객에게 적용되며, 상영관 입장 시 본인확인 증빙서류를 제시해 주시기 바랍니다. (미지참 시 입장 제한)</p>
      <p>- 장애인: 복지카드<br>- 국가유공자: 국가유공자증</p>
      <p>위 항목 외 지점별 우대요금 추가적용 대상은 직원확인 후 발권이 가능합니다<br>
      *우대선택 시 추가 할인이 제한될 수 있습니다.<br>
      *국가유공자증에 한하며, 국가유공자 유족증 등은 할인이 불가합니다.</p>
    </div>
    <button type="button" class="modal-confirm" data-confirm="DISABLED">확인</button>
  </div>
</div>

<!-- 결제 전 확인 팝업 -->
<div id="checkoutModal" class="modal-overlay" style="display:none;">
  <div class="modal-box checkout-modal-box">
    <div class="checkout-modal-header">
      <strong>결제 전 확인해 주세요</strong>
      <button type="button" id="checkoutCloseBtn" class="modal-close-plain" title="팝업 닫기" aria-label="팝업 닫기">&times;</button>
    </div>
    <div id="checkoutBody" class="checkout-modal-body"></div>
    <div class="checkout-modal-footer">
      <button type="button" id="checkoutConfirmBtn" class="btn-checkout">결제하기</button>
    </div>
  </div>
</div>

<script>
  var PRICES = <%- JSON.stringify(prices) %>;
  var SHOWTIME_ID = <%= showtime.id %>;
  var MOVIE_AGE_RATING = <%- JSON.stringify(showtime.movie.ageRating) %>;
  var CLOCK_ICON = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><polyline points="12 7 12 12 15.5 13.5"></polyline></svg>';
  var WARNING_ICON = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 2 20h20L12 3z"></path><line x1="12" y1="9" x2="12" y2="14"></line><circle cx="12" cy="17.2" r="1" fill="currentColor" stroke="none"></circle></svg>';
  var counts = { ADULT: 0, TEEN: 0, SENIOR: 0, DISABLED: 0 };
  var acknowledged = { SENIOR: false, DISABLED: false };
  var selectedGroups = []; // array of arrays of seat labels (pairs or a single leftover seat)
  var errorEl = document.getElementById('bookError');

  function totalTickets() {
    return counts.ADULT + counts.TEEN + counts.SENIOR + counts.DISABLED;
  }
  function selectedSeatCount() {
    return selectedGroups.reduce(function (n, g) { return n + g.length; }, 0);
  }
  function totalPrice() {
    return counts.ADULT * PRICES.ADULT + counts.TEEN * PRICES.TEEN +
      counts.SENIOR * PRICES.SENIOR + counts.DISABLED * PRICES.DISABLED;
  }

  function showError(msg) {
    errorEl.textContent = msg;
    errorEl.style.display = '';
  }
  function clearError() {
    errorEl.style.display = 'none';
  }

  function seatEl(label) {
    return document.querySelector('.seat[data-label="' + label + '"]');
  }
  function seatAt(row, col) {
    return document.querySelector('.seat[data-row="' + row + '"][data-col="' + col + '"]');
  }
  function isSeatFree(el) {
    if (!el || el.classList.contains('booked')) return false;
    var label = el.dataset.label;
    return selectedGroups.every(function (g) { return g.indexOf(label) === -1; });
  }
  // 실제 상영관처럼 좌석은 (1,2)(3,4)(5,6)... 고정된 짝으로만 묶인다.
  // 즉 2번 좌석의 짝은 항상 1번이고, 3번 좌석의 짝은 항상 4번이라
  // 2번-3번처럼 짝 경계를 넘나드는 조합은 나오지 않는다.
  function findAdjacentPartner(row, col) {
    var partnerCol = col % 2 === 0 ? col + 1 : col - 1;
    var partner = seatAt(row, partnerCol);
    return isSeatFree(partner) ? partner.dataset.label : null;
  }

  function render() {
    Object.keys(counts).forEach(function (cat) {
      document.getElementById('count-' + cat).textContent = counts[cat];
    });
    document.getElementById('selectedCountText').textContent =
      '선택 좌석 ' + selectedSeatCount() + ' / ' + totalTickets();
    document.getElementById('totalPriceText').textContent = totalPrice().toLocaleString() + '원';

    document.querySelectorAll('.seat:not(.booked)').forEach(function (el) {
      el.classList.remove('selected');
    });
    var selectedLabels = selectedGroups.flat();
    selectedLabels.forEach(function (label) {
      var el = seatEl(label);
      if (el) el.classList.add('selected');
    });

    var chipsEl = document.getElementById('selectedSeatChips');
    if (selectedLabels.length === 0) {
      chipsEl.innerHTML = '<span class="seat-sidebar-empty">좌석을 선택해주세요</span>';
    } else {
      chipsEl.innerHTML = selectedLabels
        .map(function (label) { return '<span class="seat-sidebar-chip">' + label + '</span>'; })
        .join('');
    }

    var total = totalTickets();
    var confirmBtn = document.getElementById('confirmBookBtn');
    confirmBtn.disabled = !(total > 0 && selectedSeatCount() === total);
  }

  function resetSelection() {
    selectedGroups = [];
    clearError();
  }

  function changeCount(category, delta) {
    if (delta > 0 && (category === 'SENIOR' || category === 'DISABLED') && !acknowledged[category]) {
      var modalId = category === 'SENIOR' ? 'seniorModal' : 'disabledModal';
      document.getElementById(modalId).style.display = 'flex';
      return;
    }
    var next = counts[category] + delta;
    if (next < 0) return;
    counts[category] = next;
    resetSelection();
    render();
  }

  document.querySelectorAll('.counter-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      changeCount(btn.dataset.category, Number(btn.dataset.delta));
    });
  });

  document.querySelectorAll('.modal-close').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.getElementById(btn.dataset.modal).style.display = 'none';
    });
  });
  document.querySelectorAll('.modal-confirm').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var category = btn.dataset.confirm;
      acknowledged[category] = true;
      counts[category] = counts[category] + 1;
      resetSelection();
      render();
      btn.closest('.modal-overlay').style.display = 'none';
    });
  });

  document.getElementById('resetBtn').addEventListener('click', function () {
    counts = { ADULT: 0, TEEN: 0, SENIOR: 0, DISABLED: 0 };
    resetSelection();
    render();
  });

  document.querySelectorAll('.seat:not(.booked)').forEach(function (el) {
    el.addEventListener('click', function () {
      clearError();
      var label = el.dataset.label;
      var row = Number(el.dataset.row);
      var col = Number(el.dataset.col);
      var total = totalTickets();

      if (total === 0) {
        showError('관람인원을 먼저 선택해주세요.');
        return;
      }

      // toggle off: clicking a seat that's part of an already-selected group
      for (var i = 0; i < selectedGroups.length; i++) {
        if (selectedGroups[i].indexOf(label) !== -1) {
          selectedGroups.splice(i, 1);
          render();
          return;
        }
      }

      if (selectedSeatCount() >= total) {
        showError('선택 가능한 좌석 수를 초과했습니다.');
        return;
      }

      var remaining = total - selectedSeatCount();
      if (remaining === 1) {
        selectedGroups.push([label]);
      } else {
        var partner = findAdjacentPartner(row, col);
        if (!partner) {
          showError('옆자리에 빈 좌석이 없어 짝을 지을 수 없습니다. 다른 좌석을 선택해주세요.');
          return;
        }
        selectedGroups.push([label, partner]);
      }
      render();
    });

    el.addEventListener('mouseenter', function () {
      var label = el.dataset.label;
      var inGroup = selectedGroups.some(function (g) { return g.indexOf(label) !== -1; });
      if (inGroup) return;

      el.classList.add('hover-preview');
      var remaining = totalTickets() - selectedSeatCount();
      if (remaining >= 2) {
        var partner = findAdjacentPartner(Number(el.dataset.row), Number(el.dataset.col));
        if (partner) {
          var partnerEl = seatEl(partner);
          if (partnerEl) partnerEl.classList.add('hover-preview');
        }
      }
    });
    el.addEventListener('mouseleave', function () {
      document.querySelectorAll('.seat.hover-preview').forEach(function (s) {
        s.classList.remove('hover-preview');
      });
    });
  });

  function submitBooking() {
    var seatList = selectedGroups.flat();
    fetch('/showtimes/' + SHOWTIME_ID + '/book', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        seats: seatList,
        adultCount: counts.ADULT,
        teenCount: counts.TEEN,
        seniorCount: counts.SENIOR,
        disabledCount: counts.DISABLED,
      }),
    })
      .then(function (res) { return res.json().then(function (body) { return { status: res.status, body: body }; }); })
      .then(function (result) {
        if (result.status === 200) {
          window.location.href = '/bookings';
        } else {
          showError(result.body.error || '예매에 실패했습니다.');
          window.location.reload();
        }
      });
  }

  function buildCheckoutBody() {
    var parts = [];

    if (MOVIE_AGE_RATING === '15' || MOVIE_AGE_RATING === '12') {
      parts.push(
        '<div class="checkout-section">' +
          '<div class="checkout-section-head">' +
            '<span class="age-badge age-' + MOVIE_AGE_RATING + '">' + MOVIE_AGE_RATING + '</span>' +
            '<strong>본 영화는 [' + MOVIE_AGE_RATING + '세이상관람가]입니다.</strong>' +
          '</div>' +
          '<p>만 ' + MOVIE_AGE_RATING + '세 미만 고객은 19세 이상 성인 보호자 동반 시 관람이 가능합니다. 연령 확인 불가 시 입장이 제한될 수 있습니다.</p>' +
          '<p class="checkout-note">※ 생년월일 확인 수단 지참 : 학생증 , 모바일학생증, 청소년증, 여권</p>' +
          '<p class="checkout-note checkout-note-red">(사진, 캡쳐본 불가)</p>' +
        '</div>'
      );
    }

    parts.push(
      '<div class="checkout-section">' +
        '<div class="checkout-section-head">' + CLOCK_ICON + '<strong>취소/환불 불가 안내</strong></div>' +
        '<p>모바일을 통해 취소하실 경우 상영시간 20분 전까지 취소 가능하며, 현장에서 취소하실 경우 상영시간 이전까지 취소하실 수 있으며 상영시간 이후 취소/환불/결제 수단 변경은 불가합니다.</p>' +
      '</div>'
    );

    parts.push(
      '<div class="checkout-section">' +
        '<div class="checkout-section-head">' + WARNING_ICON + '<strong>입장 시 유의사항</strong></div>' +
        '<p class="checkout-note-red">입장 지연에 따른 관람 불편을 최소화하기 위해 본 영화는 10분 후 상영이 시작됩니다.</p>' +
      '</div>'
    );

    if (counts.SENIOR > 0) {
      parts.push(
        '<div class="checkout-section">' +
          '<div class="checkout-section-head">' + CLOCK_ICON + '<strong>경로 권종 안내</strong></div>' +
          '<p>경로 발권은 만 65세 이상 고객에게 적용되며 상영관 입장 시 본인확인 (신분증) 후 기준에 따라 입장이 제한될 수 있습니다.</p>' +
        '</div>'
      );
    }

    if (counts.DISABLED > 0) {
      parts.push(
        '<div class="checkout-section">' +
          '<div class="checkout-section-head">' + CLOCK_ICON + '<strong>우대 권종 안내</strong></div>' +
          '<p>우대 발권은 장애인 고객에게 적용되며 상영관 입장 시 본인확인(복지카드) 후 기준에 따라 입장이 제한될 수 있습니다.<br>' +
          '※ 장애중증 : 동반 1인 포함 할인<br>' +
          '※ 장애경증 : 본인에 한하여 할인 적용<br>' +
          '※ 국가유공자 우대요금은 현장에서 국가유공자증 확인 후 발권이 가능합니다.</p>' +
        '</div>'
      );
    }

    return parts.join('');
  }

  document.getElementById('confirmBookBtn').addEventListener('click', function () {
    clearError();
    document.getElementById('checkoutBody').innerHTML = buildCheckoutBody();
    document.getElementById('checkoutModal').style.display = 'flex';
  });

  document.getElementById('checkoutCloseBtn').addEventListener('click', function () {
    document.getElementById('checkoutModal').style.display = 'none';
  });

  document.getElementById('checkoutConfirmBtn').addEventListener('click', function () {
    document.getElementById('checkoutModal').style.display = 'none';
    submitBooking();
  });

  render();
</script>
<%- include('partials/footer') %>
</body>
</html>
