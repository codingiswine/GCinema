<!-- 연령등급 확인 팝업 (공용) -->
<div id="ageGateModal" class="modal-overlay" style="display:none;">
  <div class="modal-box">
    <div class="modal-header">
      <span>알림</span>
      <button type="button" class="modal-close" id="ageGateCloseBtn">&times;</button>
    </div>
    <div class="modal-body age-gate-body" id="ageGateBody"></div>
    <button type="button" class="modal-confirm" id="ageGateConfirmBtn">확인</button>
  </div>
</div>
<script>
  var AGE_GATE_CONTENT = {
    '15': {
      title: '15세이상관람가',
      lines: [
        '15 세 미만의 고객님은(영,유아 포함)<br>반드시 성인 보호자의 동반하에 관람이 가능합니다.',
        '(확인 불가 시 입장제한)',
        '*관람 등급 확인을 위해 신분증(주민등록증, 학생증, 청소년증, 여권 등) 확인을 요청할 수 있습니다.',
      ],
    },
    '12': {
      title: '12세이상관람가',
      lines: [
        '12 세 미만의 고객님은(영,유아 포함)<br>반드시 성인 보호자의 동반하에 관람이 가능합니다.',
        '(확인불가 시 입장제한)',
        '*관람 등급 확인을 위해 신분증(주민등록증, 학생증, 청소년증, 여권 등) 확인을 요청할 수 있습니다.',
      ],
    },
  };
  function ageGateNeeded(rating) {
    return AGE_GATE_CONTENT.hasOwnProperty(rating);
  }
  function openAgeGate(rating, onConfirm) {
    var info = AGE_GATE_CONTENT[rating];
    document.getElementById('ageGateBody').innerHTML =
      '<span class="age-badge age-' + rating + ' age-gate-badge">' + rating + '</span>' +
      '<p class="age-gate-title">' + info.title + '</p>' +
      info.lines.map(function (l) { return '<p>' + l + '</p>'; }).join('');
    document.getElementById('ageGateModal').style.display = 'flex';
    document.getElementById('ageGateConfirmBtn').onclick = function () {
      document.getElementById('ageGateModal').style.display = 'none';
      onConfirm();
    };
  }
  document.getElementById('ageGateCloseBtn').addEventListener('click', function () {
    document.getElementById('ageGateModal').style.display = 'none';
  });
</script>
