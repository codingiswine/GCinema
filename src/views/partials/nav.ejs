<header class="brand">
  <a href="/movies" class="brand-link">
    <span class="brand-name-wrap">
      <img src="/gc-mark.png" alt="" class="brand-mark" />
      <span class="brand-name">GCinema</span>
    </span>
  </a>
  <p class="brand-tagline">Beyond Screens, Toward Connected Cinema</p>
</header>
<nav>
  <div class="nav-left">
    <div class="breadcrumb">
      <% var crumbs = (typeof breadcrumb !== 'undefined' && breadcrumb) ? breadcrumb : [{ label: '영화 목록', href: '/movies' }]; %>
      <% crumbs.forEach(function (c, i) { %>
        <% if (i > 0) { %><span class="breadcrumb-sep">&gt;</span><% } %>
        <% if (i === 0 && c.href) { %>
          <a href="<%= c.href %>" class="breadcrumb-home" title="<%= c.label %>" aria-label="<%= c.label %>">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round">
              <path d="M12,4 L20,11 L20,20 L4,20 L4,11 Z" />
              <circle cx="12" cy="15" r="1.4" fill="currentColor" stroke="none" />
            </svg>
          </a>
        <% } else if (c.href) { %>
          <a href="<%= c.href %>"><%= c.label %></a>
        <% } else { %>
          <span class="breadcrumb-current"><%= c.label %></span>
        <% } %>
      <% }) %>
    </div>
  </div>
  <div class="nav-right">
    <% if (userId) { %>
      <a href="/bookings">마이페이지</a>
      <form action="/logout" method="post" style="margin:0">
        <button type="submit" style="padding:2px 8px">로그아웃</button>
      </form>
    <% } else { %>
      <a href="/login">로그인</a>
    <% } %>
    <a href="/support">고객센터</a>
  </div>
</nav>
