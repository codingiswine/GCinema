generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int         @id @default(autoincrement())
  username     String      @unique
  email        String      @unique
  phone        String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  bookings     Booking[]
  movieLikes   MovieLike[]
}

model Movie {
  id                  Int        @id @default(autoincrement())
  title               String
  genre               String
  runningTimeMin      Int
  ageRating           String
  posterUrl           String?
  detailImageUrl      String?
  description         String     @default("")
  satisfactionPercent Int
  bookingRatePercent  Float
  cumulativeViewers   String
  createdAt           DateTime    @default(now())
  showtimes           Showtime[]
  likes               MovieLike[]
}

model MovieLike {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  movie     Movie    @relation(fields: [movieId], references: [id])
  movieId   Int
  createdAt DateTime @default(now())

  @@unique([userId, movieId])
}

model Showtime {
  id          Int       @id @default(autoincrement())
  movie       Movie     @relation(fields: [movieId], references: [id])
  movieId     Int
  theaterName String
  startAt     DateTime
  totalSeats  Int
  cols        Int
  bookings    Booking[]
}

enum TicketCategory {
  ADULT
  TEEN
  SENIOR
  DISABLED
}

enum PaymentMethod {
  CARD
  KAKAO_PAY
  NAVER_PAY
  BANK_TRANSFER
}

model Booking {
  id         Int            @id @default(autoincrement())
  user       User           @relation(fields: [userId], references: [id])
  userId     Int
  showtime   Showtime       @relation(fields: [showtimeId], references: [id])
  showtimeId Int
  seatLabel  String
  category   TicketCategory
  price      Int
  bookedAt   DateTime       @default(now())

  // 한 번의 결제로 잡힌 좌석들이 공유하는 예매번호와 결제수단.
  // 시드로 미리 채워둔 좌석은 결제를 거치지 않으므로 null이다.
  reservationNo String?
  paymentMethod PaymentMethod?

  // 취소는 행을 지우지 않고 이 값만 채우는 소프트 삭제다. 고객 관리·마케팅
  // 분석(취소율, 재예매 패턴 등)을 위해 취소 이력도 DB에 남겨두기 위함.
  // 같은 회차·좌석이라도 "활성" 예매끼리만 겹치면 안 되므로, 실제 중복 방지는
  // @@unique가 아니라 마이그레이션에서 만든 부분 유니크 인덱스
  // (WHERE "cancelledAt" IS NULL)가 담당한다 — Prisma 스키마는 조건부 유니크
  // 제약을 표현하지 못해 여기 선언만으로는 보이지 않는다.
  cancelledAt DateTime?

  @@index([showtimeId, seatLabel])
  @@index([reservationNo])
}
