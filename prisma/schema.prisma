generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int         @id @default(autoincrement())
  username     String      @unique
  email        String      @unique
  phone        String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  bookings         Booking[]
  movieLikes       MovieLike[]
  checkoutAttempts CheckoutAttempt[]
  movieReviews     MovieReview[]
}

model Movie {
  id                  Int        @id @default(autoincrement())
  title               String
  genre               String
  runningTimeMin      Int
  ageRating           String
  posterUrl           String?
  detailImageUrl      String?
  description         String     @default("")
  satisfactionPercent Int
  bookingRatePercent  Float
  cumulativeViewers   String
  createdAt           DateTime    @default(now())
  showtimes           Showtime[]
  likes               MovieLike[]
  reviews             MovieReview[]
}

model MovieLike {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  movie     Movie    @relation(fields: [movieId], references: [id])
  movieId   Int
  createdAt DateTime @default(now())

  @@unique([userId, movieId])
}

model Showtime {
  id          Int       @id @default(autoincrement())
  movie       Movie     @relation(fields: [movieId], references: [id])
  movieId     Int
  theaterName String
  startAt     DateTime
  totalSeats  Int
  cols        Int
  bookings    Booking[]
  checkoutAttempts CheckoutAttempt[]

  @@index([movieId, startAt])
}

enum TicketCategory {
  ADULT
  TEEN
  SENIOR
  DISABLED
}

enum PaymentMethod {
  CARD
  KAKAO_PAY
  NAVER_PAY
  BANK_TRANSFER
}

model Booking {
  id         Int            @id @default(autoincrement())
  user       User           @relation(fields: [userId], references: [id])
  userId     Int
  showtime   Showtime       @relation(fields: [showtimeId], references: [id])
  showtimeId Int
  seatLabel  String
  category   TicketCategory
  price      Int
  bookedAt   DateTime       @default(now())

  // 한 번의 결제로 잡힌 좌석들이 공유하는 예매번호와 결제수단.
  // 시드로 미리 채워둔 좌석은 결제를 거치지 않으므로 null이다.
  reservationNo String?
  paymentMethod PaymentMethod?

  // 취소는 행을 지우지 않고 이 값만 채우는 소프트 삭제다. 고객 관리·마케팅
  // 분석(취소율, 재예매 패턴 등)을 위해 취소 이력도 DB에 남겨두기 위함.
  // 같은 회차·좌석이라도 "활성" 예매끼리만 겹치면 안 되므로, 실제 중복 방지는
  // @@unique가 아니라 마이그레이션에서 만든 부분 유니크 인덱스
  // (WHERE "cancelledAt" IS NULL)가 담당한다 — Prisma 스키마는 조건부 유니크
  // 제약을 표현하지 못해 여기 선언만으로는 보이지 않는다.
  cancelledAt DateTime?

  @@index([showtimeId, seatLabel])
  @@index([reservationNo])
  @@index([userId, cancelledAt])
}

// 결제 페이지까지 도달한 시도를 기록한다. 결제(POST /pay)가 성공해야만
// Booking이 생기므로, 이 로그가 없으면 "좌석까지 골랐지만 결제는 안 한 사람"이
// DB 어디에도 남지 않는다 — 재방문 유도 같은 마케팅에 쓰려면 이 이탈 지점이
// 필요하다. completedAt이 null이면 결제까지 이어지지 않은 시도다.
model CheckoutAttempt {
  id          Int       @id @default(autoincrement())
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
  showtime    Showtime  @relation(fields: [showtimeId], references: [id])
  showtimeId  Int
  seats       String
  totalPrice  Int
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId])
  @@index([showtimeId, completedAt])
}

// 관람한 영화에 남기는 평점(1~5)/한줄평/영화일기. 영화 한 편당 사용자 한 명이
// 하나만 남기므로 MovieLike와 같은 (userId, movieId) 유니크 패턴을 쓰고,
// 평점만 남기거나 일기만 남기는 경우도 있어 세 필드 모두 선택 입력이다.
// rating의 1~5 범위는 마이그레이션에서 만든 CHECK 제약이 DB에서도 강제한다
// (Prisma 스키마는 CHECK를 표현하지 못해 여기 선언만으로는 보이지 않는다).
model MovieReview {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  movie     Movie    @relation(fields: [movieId], references: [id])
  movieId   Int
  rating    Int?
  comment   String?
  diary     String?
  updatedAt DateTime @updatedAt

  @@unique([userId, movieId])
}
